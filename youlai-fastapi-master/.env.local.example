# ============================================================
# 生产环境配置模板（不入 git）
#
# 使用方法：复制此文件为 .env.local 并填入真实密钥
#   cp .env.local.example .env.local
#
# pydantic-settings 优先读 .env.local，会覆盖 .env 中同名配置
# ============================================================

# ── AI 服务（三选一，取消注释即可） ──

# 阿里云百炼 DashScope
AI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_API_KEY=sk-your-key
AI_MODEL=deepseek-v4-flash-0731

# DeepSeek 官方
# AI_API_BASE=https://api.deepseek.com/v1
# AI_API_KEY=sk-your-key
# AI_MODEL=deepseek-chat

# Azure OpenAI
# AI_API_BASE=https://your-resource.openai.azure.com/openai/v1
# AI_API_KEY=your-key
# AI_MODEL=DeepSeek-V4-Flash

AI_TEMPERATURE=0.7
AI_MAX_TOKENS=4096

# ── Embedding（生产用外部 Ollama） ──
EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://<外部Ollama-IP>:11434
OLLAMA_EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024

# ── 日志级别 ──
LOG_LEVEL=WARNING

# ── 容器内网地址（覆盖 .env 中的 localhost，Docker Compose 内生效） ──
DATABASE_URL=postgresql+asyncpg://youlai:Youlai%402026@tc-postgres:5432/youlai_admin
REDIS_URL=redis://:TestCopilot@2026@tc-redis:6379/0
MINIO_ENDPOINT=tc-minio:9000
ES_HOST=http://tc-es:9200
MILVUS_HOST=tc-milvus
