# ==================== 敏感配置模板（不入 git，字段与 .env.local 一致） ====================
# 使用方法：复制此文件为 .env.local 并填入真实密钥
#   cp .env.local.example .env.local
#
# pydantic-settings 优先读 .env.local，会覆盖 .env 中的同名占位符
# 此文件可推送仓库，但严禁把真实密钥填入后提交

# ── 数据库（填入真实密码，注意特殊字符需 URL 编码） ──
DATABASE_URL=postgresql+asyncpg://youlai:CHANGE_ME@localhost:15432/youlai_admin

# ── Redis（填入真实密码） ──
REDIS_URL=redis://:CHANGE_ME@localhost:6379/0

# ── JWT 认证密钥（建议用 openssl rand -hex 32 生成） ──
JWT_SECRET_KEY=CHANGE_ME_to_a_random_64_char_secret

# ── MinIO 文件存储 ──
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME

# ── AI 服务（阿里云百炼 DashScope，兼容 OpenAI 接口） ──
AI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_API_KEY=sk-your-key
AI_MODEL=deepseek-v4-flash-0731
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=4096
