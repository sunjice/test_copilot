# ==================== 数据库 ====================
# 复制此文件为 .env 并填入真实值：cp .env.example .env
DATABASE_URL=postgresql+asyncpg://youlai:your-password@localhost:15432/youlai_admin

# ==================== Redis ====================
REDIS_URL=redis://:your-redis-password@localhost:6379/0

# ==================== 认证 ====================
SESSION_TYPE=jwt
JWT_SECRET_KEY=change-me-to-a-random-64-char-secret
ACCESS_TOKEN_TTL=7200
REFRESH_TOKEN_TTL=604800
ALLOW_MULTI_LOGIN=true

# ==================== MinIO 文件存储 ====================
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=public
MINIO_SECURE=false

# ==================== 邮件（可选） ====================
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-password
MAIL_FROM=noreply@example.com
MAIL_PORT=587
MAIL_SERVER=smtp.example.com
MAIL_STARTTLS=true
MAIL_SSL_TLS=false

# ==================== 限流 ====================
RATE_LIMIT_ENABLED=true

# ==================== CORS ====================
ALLOWED_ORIGINS=*

# ==================== 文件上传 ====================
FILE_MAX_SIZE_MB=50
FILE_ALLOWED_TYPES=jpg,jpeg,png,gif,pdf,xlsx,xls,docx,doc,zip

# ==================== AI 服务 ====================
# 在 .env.local 中配置 AI_API_KEY（真实密钥，不入 git）
AI_API_BASE=https://api.deepseek.com
AI_MODEL=deepseek-chat
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=4096
AI_BATCH_SIZE=30

# ==================== LLM 日志清理 ====================
LLM_LOG_RETENTION_DAYS=180

# ==================== Elasticsearch ====================
ES_HOST=http://localhost:9200
ES_INDEX_CASE=tc_cases
ES_INDEX_BUG=tc_bugs

# ==================== Milvus ====================
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION_CASE=tc_cases
MILVUS_COLLECTION_BUG=tc_bugs

# ==================== Embedding ====================
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=models/bge-large-zh-v1.5
EMBEDDING_DIM=1024
EMBEDDING_DEVICE=cpu

# ==================== 调试 ====================
DEBUG=false
LOG_LEVEL=INFO
