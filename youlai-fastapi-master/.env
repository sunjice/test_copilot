# ==================== 数据库 ====================
DATABASE_URL=postgresql+asyncpg://youlai:Youlai%402026@localhost:15432/youlai_admin

# ==================== Redis ====================
REDIS_URL=redis://:123456@127.0.0.1:6379/0

# ==================== 认证 ====================
SESSION_TYPE=jwt
JWT_SECRET_KEY=SecretKey012345678901234567890123456789012345678901234567890123456789
ACCESS_TOKEN_TTL=7200
REFRESH_TOKEN_TTL=604800
ALLOW_MULTI_LOGIN=true

# ==================== MinIO 文件存储 ====================
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=public
MINIO_SECURE=false

# ==================== 邮件（可选） ====================
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-password
MAIL_FROM=noreply@example.com
MAIL_PORT=587
MAIL_SERVER=smtp.example.com
MAIL_STARTTLS=true
MAIL_SSL_TLS=false

# ==================== 限流 ====================
RATE_LIMIT_ENABLED=true

# ==================== CORS ====================
ALLOWED_ORIGINS=*

# ==================== 文件上传 ====================
FILE_MAX_SIZE_MB=50
FILE_ALLOWED_TYPES=jpg,jpeg,png,gif,pdf,xlsx,xls,docx,doc,zip

# ==================== LLM 日志清理 ====================
LLM_LOG_RETENTION_DAYS=180

# ==================== Elasticsearch ====================
ES_HOST=http://localhost:9200
ES_INDEX_CASE=tc_cases
ES_INDEX_BUG=tc_bugs

# ==================== Milvus ====================
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION_CASE=tc_cases
MILVUS_COLLECTION_BUG=tc_bugs

# ==================== Embedding ====================
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=models/bge-large-zh-v1.5
EMBEDDING_DIM=1024
EMBEDDING_DEVICE=cpu

# ==================== 调试 ====================
DEBUG=false
LOG_LEVEL=INFO
